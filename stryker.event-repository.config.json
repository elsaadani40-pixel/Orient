{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test --test-timeout=120000 test/unit/infrastructure/event-repository.test.js test/unit/infrastructure/event-repository-hardening.test.js test/unit/infrastructure/mission-event-repository.test.js test/unit/infrastructure/persistence/json/event-repository.security.test.js"
  },
  "mutate": ["src/infrastructure/persistence/json/event.repository.js"],
  "reporters": ["clear-text", "html", "json"],
  "concurrency": 2,
  "timeoutMS": 120000,
  "timeoutFactor": 2,
  "cleanTempDir": true,
  "thresholds": { "high": 80, "low": 60, "break": 60 }
}
