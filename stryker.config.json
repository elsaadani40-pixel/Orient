{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test --test-timeout=120000 test/unit/core/security/owner-auth-service.test.js test/unit/core/runtime/request-execution-coordinator.test.js test/unit/infrastructure/event-repository.test.js"
  },
  "mutate": [
    "src/core/security/owner-auth-service.js",
    "src/core/runtime/request-execution-coordinator.js",
    "src/infrastructure/persistence/json/event.repository.js"
  ],
  "reporters": [
    "clear-text",
    "html",
    "json"
  ],
  "concurrency": 2,
  "timeoutMS": 120000,
  "timeoutFactor": 2,
  "cleanTempDir": true
}
