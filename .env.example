# Copy to .env for local development. Never put real credentials in this file.
PORT=8080
HOST=127.0.0.1
NODE_ENV=development

# json (default) or postgres
ORIENT_PERSISTENCE=json
# Set locally only when ORIENT_PERSISTENCE=postgres. Never commit a real URL.
ORIENT_DATABASE_URL=

ORIENT_DATABASE_POOL_MAX=10
ORIENT_DATABASE_IDLE_TIMEOUT_MS=30000
ORIENT_DATABASE_CONNECTION_TIMEOUT_MS=5000
ORIENT_TENANT_ID=local

ORIENT_MAX_INPUT_CHARS=100000
ORIENT_MAX_TOOL_INPUT_CHARS=50000
ORIENT_MAX_QUEUE_DEPTH=1000
ORIENT_WORKFLOW_DISPATCH_WINDOW=2
ORIENT_WORKFLOW_AGING_QUANTUM_MS=30000
ORIENT_MAX_WORKFLOW_RETRIES=2
ORIENT_WORKFLOW_LEASE_MS=30000
ORIENT_SHUTDOWN_GRACE_MS=10000

# none (default) or ollama
ORIENT_MODEL_PROVIDER=none
ORIENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
ORIENT_OLLAMA_MODEL=llama3.2:3b
ORIENT_OLLAMA_TIMEOUT_MS=60000
